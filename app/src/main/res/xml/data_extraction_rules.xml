<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ counterpart of backup_rules.xml. Cloud backup (Google
   account) and device-to-device transfer both include the full local
   store: Room database + preferences. No credentials are ever stored,
   so nothing needs excluding.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
