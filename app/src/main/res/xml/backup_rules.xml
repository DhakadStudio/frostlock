<?xml version="1.0" encoding="utf-8"?>
<!--
   FrostLock stores everything locally: focus history (Room), preferences
   (DataStore / SharedPreferences) and nothing else. No credentials, no
   tokens. Back all of it up so a device wipe, broken screen or accidental
   uninstall (see docs/frostlock-redesign-qa-audit.md §9 incident note)
   does not silently destroy the user's streaks and history.
   Used on devices before Android 12 (fullBackupContent).
-->
<full-backup-content>
    <include domain="database" path="."/>
    <include domain="sharedpref" path="."/>
</full-backup-content>
