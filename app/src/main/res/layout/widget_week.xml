<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/week_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_frost_snowflake"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:letterSpacing="0.08"
        android:text="@string/widget_week_title"
        android:textColor="@color/widget_accent"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/week_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_week_total_placeholder"
        android:textColor="@color/widget_text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/week_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_week_meta_placeholder"
        android:textColor="@color/widget_text_secondary"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/week_day_0"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="M"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/week_bar_0"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="45"
            android:progressBackgroundTint="@color/widget_progress_track"
            android:progressTint="@color/widget_progress" />

        <TextView
            android:id="@+id/week_value_0"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="45m"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/week_day_1"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="T"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/week_bar_1"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="62"
            android:progressBackgroundTint="@color/widget_progress_track"
            android:progressTint="@color/widget_progress" />

        <TextView
            android:id="@+id/week_value_1"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="1h 5m"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/week_day_2"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="W"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/week_bar_2"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="30"
            android:progressBackgroundTint="@color/widget_progress_track"
            android:progressTint="@color/widget_progress" />

        <TextView
            android:id="@+id/week_value_2"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="30m"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/week_day_3"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="T"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/week_bar_3"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="80"
            android:progressBackgroundTint="@color/widget_progress_track"
            android:progressTint="@color/widget_progress" />

        <TextView
            android:id="@+id/week_value_3"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="1h 30m"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/week_day_4"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="F"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/week_bar_4"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="36"
            android:progressBackgroundTint="@color/widget_progress_track"
            android:progressTint="@color/widget_progress" />

        <TextView
            android:id="@+id/week_value_4"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="36m"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/week_day_5"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="S"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/week_bar_5"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="@color/widget_progress_track"
            android:progressTint="@color/widget_progress" />

        <TextView
            android:id="@+id/week_value_5"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0m"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/week_day_6"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="S"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/week_bar_6"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="52"
            android:progressBackgroundTint="@color/widget_progress_track"
            android:progressTint="@color/widget_progress" />

        <TextView
            android:id="@+id/week_value_6"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="52m"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
