<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/goal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_frost_snowflake"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:letterSpacing="0.08"
        android:text="@string/widget_goal_title"
        android:textColor="@color/widget_accent"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/goal_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_goal_percent_placeholder"
        android:textColor="@color/widget_text_primary"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/goal_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_goal_sub_placeholder"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />

    <ProgressBar
        android:id="@+id/goal_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="62"
        android:progressBackgroundTint="@color/widget_progress_track"
        android:progressTint="@color/widget_progress" />

    <TextView
        android:id="@+id/goal_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_streak_placeholder"
        android:textColor="@color/widget_text_secondary"
        android:textSize="10sp" />

</LinearLayout>
